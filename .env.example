# Copy to .env and fill in. Never commit .env.
OMIBRIDGE_TOKEN=            # long random string; part of the webhook URL
OPENROUTER_API_KEY=         # for MAI Transcribe 2
OMIBRIDGE_WEARER=           # the name you enroll yourself under (optional)
OMIBRIDGE_DATA=data/bridge
# OMIBRIDGE_OMI_WRITEBACK=1 # also post each conversation into Omi (makes a second copy there)
# OMI_API_KEY=              # Omi developer key with conversations:write, for the line above

# Copy to .env and fill in. Never commit .env.
OMIBRIDGE_TOKEN=            # long random string; part of the webhook URL
OPENROUTER_API_KEY=         # for MAI Transcribe 2 and the conversation summaries
OMIBRIDGE_WEARER=           # the name you enroll yourself under (optional)
OMIBRIDGE_DATA=data/bridge
# OMIBRIDGE_OMI_WRITEBACK=1 # also post each conversation into Omi (makes a second copy there)
# OMI_API_KEY=              # Omi developer key with conversations:write, for the line above
# OMIBRIDGE_SUMMARIZE=0     # turn the summaries off
# OMIBRIDGE_SUMMARY_MODEL=anthropic/claude-sonnet-5.5   # any chat model on OpenRouter
# App API for the forked Omi app (scripts/build_fork.sh), served on the public port under
# /app/<secret>/ and built into the app. Off while empty. Rotating it signs the app out.
OMIBRIDGE_APP_SECRET=       # generated by scripts/install_mac.sh; never share it
# OMIBRIDGE_APP_UID=owner   # the one account the app signs in as
